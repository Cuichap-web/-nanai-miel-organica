# Variables de entorno - NANAI Miel Orgánica
# Copiar a .env y completar con valores reales
# NUNCA versionar .env

# Entorno
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nanai_app
DB_PASSWORD=
DB_NAME=nanai_miel

# Sesiones
SESSION_SECRET=
SESSION_NAME=nanai.sid

# Stock / Reservas
RESERVA_TTL_MINUTOS=30

# Argon2
ARGON2_OPTIONS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Correo (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@nanai.pe

# Almacenamiento
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Pagos
PAGOS_PROVEEDOR=test
PAGOS_API_KEY=
PAGOS_WEBHOOK_SECRET=
PAGOS_VERIFICACION_CRUZADA=false

# DNI
DNI_PROVEEDOR=
DNI_API_KEY=

# Seguridad
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000
